# =========================================================================
# CineMod .gitignore
# =========================================================================

# Build Directories
build/
bin/
out/
dist/
cmake-build-*/

# Compiler & Linker Outputs
*.exe
*.obj
*.o
*.a
*.lib
*.dll
*.so
*.dylib
*.pdb
*.ilk
*.exp

# CMake Generated Files
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
compile_commands.json
install_manifest.txt
CTestTestfile.cmake

# Dear ImGui Runtime Layout Configuration
imgui.ini

# IDE & Editor specific files
.vs/
*.user
*.suo
*.sln.docstates
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# External cloned libraries (GLFW, GLM, ImGui are fetched into build/_deps)
external/imguizmo/

# Operating System specific files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary & Crash files
*.tmp
*.log
*.bak
